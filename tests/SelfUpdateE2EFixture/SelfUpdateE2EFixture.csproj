<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>SelfUpdateE2EFixture</AssemblyName><Product>RenoDX MFG Unlocker</Product><Version>1.2.0</Version><InformationalVersion>$(FixtureVersion)</InformationalVersion><SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../RenoDXMfgUnlocker/RenoDXMfgUnlocker.csproj"/>
    <EmbeddedResource Include="$(FixturePublicKeyFile)" LogicalName="SelfUpdateE2EFixture.PublicKey"/>
    <EmbeddedResource Include="$(FixtureRootFile)" LogicalName="SelfUpdateE2EFixture.Root"/>
  </ItemGroup>
  <Target Name="RequireTestResources" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FixtureVersion)'=='' Or '$(FixturePublicKeyFile)'=='' Or '$(FixtureRootFile)'==''" Text="This non-shipping fixture requires explicit isolated root, public test key and version."/>
  </Target>
</Project>
