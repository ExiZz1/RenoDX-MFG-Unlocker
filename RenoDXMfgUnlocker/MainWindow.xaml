<Window x:Class="RenoDXMfgUnlocker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RenoDX MFG Unlocker" Icon="pack://application:,,,/Assets/RenoDX.ico" Width="1180" Height="820" MinWidth="900" MinHeight="650" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Loaded="Window_Loaded">
 <Border Background="{StaticResource Bg}" CornerRadius="18" BorderBrush="#30313C" BorderThickness="1" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#111218" MouseLeftButtonDown="Header_Drag"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Width="28" Height="28" Source="pack://application:,,,/Assets/RenoDX.png" Stretch="Uniform" Margin="-1,0,-1,0"/><TextBlock Text="RENO" Foreground="#F2F0F8" FontSize="13" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/><TextBlock Text="DX" Foreground="#A78BFA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="  /  MFG UNLOCKER" Foreground="#777684" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#1D1A27" BorderBrush="#373044" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="12,0,0,0"><TextBlock x:Name="AppVersionText" Text="v1.0.0" Foreground="#BEB1DD" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="HomeNavButton" Click="Home_Click" Padding="11,6" Background="#29233A" BorderBrush="#544472" Margin="0,0,6,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="⌂" FontSize="15" Foreground="#CDBEFF" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Home" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="AboutNavButton" Click="About_Click" Padding="11,6" Background="#171920" BorderBrush="#343642" Margin="0,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ⓘ" FontSize="13" Foreground="#AFA3CB" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="About" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button><Button Content="—" Width="42" Padding="0" Click="Minimize_Click" Background="Transparent" BorderThickness="0"/><Button Content="×" Width="42" Padding="0" Click="Close_Click" Background="Transparent" BorderThickness="0" FontSize="19"/></StackPanel></Grid></Border>
  <Grid x:Name="HomePage" Grid.Row="1" Margin="30,26,30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MFG UNLOCKER" Foreground="#A78BFA" FontSize="10" FontWeight="Bold"/><TextBlock Text="One clean setup. More frames." Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="Choose a game, target its executable, then install a release." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="1" Background="#17151F" BorderBrush="#383044" BorderThickness="1" CornerRadius="18" Padding="14,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#A78BFA" Margin="0,0,9,0"/><TextBlock Text="RELEASE CHANNEL" Foreground="#C5BDD5" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Border></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="24"/><ColumnDefinition Width=".98*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14"><Border Width="28" Height="28" CornerRadius="9" Background="#272238"><TextBlock Text="01" Foreground="#C7B6FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="TARGET GAME" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Pick the folder where the addon belongs" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <ComboBox x:Name="GamesCombo" Grid.Row="1" Height="43" IsEditable="False" Background="#171920" Foreground="#F4F2FA" BorderBrush="#343642" BorderThickness="1" Padding="11,8" SelectionChanged="GamesCombo_SelectionChanged">
      <ComboBox.Resources><SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#191B23"/><SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4F2FA"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#493B68"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F4F2FA"/><SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#C6BDD9"/></ComboBox.Resources>
      <ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid>
       <ToggleButton x:Name="DropDownButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ClosedField" Background="#171920" BorderBrush="#343642" BorderThickness="1" CornerRadius="10"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#BEB1DD" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ClosedField" Property="BorderBrush" Value="#65518F"/><Setter TargetName="ClosedField" Property="Background" Value="#1D1D27"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ClosedField" Property="BorderBrush" Value="#A78BFA"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ClosedField" Property="BorderBrush" Value="#8065C9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ClosedField" Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,40,0"/>
       <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"><Border Background="#191B23" BorderBrush="#343642" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"><ScrollViewer Margin="4" CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></ComboBox.Template>
     </ComboBox>
     <TextBlock Grid.Row="2" Text="GAME EXECUTABLE" Foreground="#8F8D9B" FontSize="10" FontWeight="Bold" Margin="1,16,0,8"/>
     <Grid Grid.Row="3" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ExePathBox" Grid.Row="0" Grid.ColumnSpan="2" Height="43" VerticalContentAlignment="Center" IsReadOnly="True"/><Button Grid.Row="1" Grid.Column="0" Content="Browse executable" Margin="0,10,8,0" Click="BrowseExe_Click"/><Button Grid.Row="1" Grid.Column="1" Content="Open folder ↗" Margin="0,10,0,0" Click="OpenFolder_Click"/><Border Grid.Row="2" Grid.ColumnSpan="2" Background="#101218" BorderBrush="#282A34" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock Text="INSTALL LOCATION" Foreground="#888695" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="InstallLocationText" Text="Select an executable to preview the destination" Foreground="#BBB8C5" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></Border></Grid>
     <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0"><Ellipse x:Name="GameStatusDot" Width="7" Height="7" Fill="#64616F" VerticalAlignment="Center"/><TextBlock x:Name="GameStatusText" Text="Waiting for a game" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    </Grid></Border>
    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="9" Background="#272238"><TextBlock Text="02" Foreground="#C7B6FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="CHOOSE A RELEASE" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseSubhead" Text="All published addon builds" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Content="↻" Width="38" Height="36" Padding="0" Click="Refresh_Click" ToolTip="Refresh releases"/></Grid><Grid Grid.Row="1" Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="42" Padding="12,6" FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Filter releases"/><TextBlock Grid.Column="1" x:Name="ReleaseCount" Text="0 BUILDS" Foreground="#777583" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid><ListBox x:Name="ReleasesList" Grid.Row="2" SelectionChanged="ReleasesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Resources><Style TargetType="{x:Type ScrollBar}"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ScrollBar}"><Grid Background="Transparent" SnapsToDevicePixels="True"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1,2"/></ControlTemplate></Thumb.Template><Thumb.Style><Style TargetType="{x:Type Thumb}"><Setter Property="Background" Value="#393743"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#665486"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="#8B70C4"/></Trigger></Style.Triggers></Style></Thumb.Style></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Foreground="#F1EFF7" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" Foreground="#9391A0" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="1" Background="#29233A" CornerRadius="8" Padding="9,5" VerticalAlignment="Center"><TextBlock Text="{Binding Tag}" Foreground="#C9B9FF" FontSize="10" FontWeight="Bold"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedReleaseText" Text="Select a release to continue" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="InstallButton" Grid.Column="1" Content="Install addon  →" Padding="17,11" Background="#704BD0" BorderBrush="#8E6FF0" IsEnabled="False" Click="Install_Click"/></Grid></Grid></Border>
   </Grid>
   <Border Grid.Row="2" Background="#12141A" BorderBrush="#292B35" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="LogToggle" Grid.Column="0" Content="＋  Activity" Background="Transparent" BorderThickness="0" Padding="14,11" Click="LogToggle_Click"/><TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready when you are" Foreground="#9693A1" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Clear" Background="Transparent" BorderThickness="0" Padding="12,8" Foreground="#8C8997" Click="ClearLog_Click"/></Grid></Border>
   <Border x:Name="LogPanel" Grid.Row="3" Visibility="Collapsed" Background="#0E1015" BorderBrush="#292B35" BorderThickness="1" CornerRadius="12" Margin="0,8,0,0" Padding="12" MaxHeight="125"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LogText" Foreground="#AFAABD" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/></ScrollViewer></Border>
  </Grid><Grid x:Name="AboutPage" Grid.Row="1" Margin="30,26,30,24" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock Text="RENO / ABOUT" Foreground="#A78BFA" FontSize="10" FontWeight="Bold"/><TextBlock Text="RenoDX MFG Unlocker" Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="A little about the utility and the project behind the addon." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/></StackPanel></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Background="#17151F" BorderBrush="#4A3A68" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Width="64" Height="64" Source="pack://application:,,,/Assets/RenoDX.png" Stretch="Uniform" Margin="0,0,18,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="THE APPLICATION" Foreground="#B7A3EA" FontSize="9" FontWeight="Bold"/><TextBlock Text="RenoDX MFG Unlocker" Foreground="#F4F2FA" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="RenoDX MFG Unlocker is a desktop utility for browsing published MFG Unlock releases and installing the selected addon next to a chosen game executable." Foreground="#B9B6C4" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,6,14,0"/></StackPanel><Border Grid.Column="2" Background="#211B2D" BorderBrush="#47385E" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Top"><TextBlock x:Name="AboutVersionText" Text="v1.0.0" Foreground="#D0C1F3" FontSize="11" FontWeight="SemiBold"/></Border></Grid></Border>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="APPLICATION DEVELOPER" Foreground="#A78BFA" FontSize="9" FontWeight="Bold"/><TextBlock Text="ExiZz" Foreground="#F4F2FA" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Developer of RenoDX MFG Unlocker." Foreground="#AAA7B6" FontSize="12" Margin="0,5,0,16"/><Button HorizontalAlignment="Left" Click="DeveloperProfile_Click" Padding="13,9"><StackPanel Orientation="Horizontal"><TextBlock Text="GH" Foreground="#D4C6F6" FontSize="10" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="View GitHub profile"/><TextBlock Text="  ↗" Foreground="#C9B9FF"/></StackPanel></Button></StackPanel></Border>
     <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="ORIGINAL MFG UNLOCK PROJECT" Foreground="#A78BFA" FontSize="9" FontWeight="Bold"/><TextBlock Text="mavismmg" Foreground="#F4F2FA" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Original MFG Unlock addon project maintained in the MFGAdaUnlock-RenoDx repository." Foreground="#AAA7B6" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,14"/><StackPanel Orientation="Horizontal"><Button Click="OriginalAuthor_Click" Padding="11,9" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="GH" Foreground="#D4C6F6" FontSize="10" FontWeight="Bold" Margin="0,0,7,0"/><TextBlock Text="View author profile"/></StackPanel></Button><Button Click="SourceRepository_Click" Padding="11,9"><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Foreground="#C9B9FF" Margin="0,0,7,0"/><TextBlock Text="View source repository"/></StackPanel></Button></StackPanel></StackPanel></Border>
    </Grid>
    <Border Background="#111319" BorderBrush="#292B35" BorderThickness="1" CornerRadius="12" Padding="16,14"><StackPanel><TextBlock Text="CREDITS" Foreground="#A78BFA" FontSize="9" FontWeight="Bold"/><TextBlock Text="Credits to the original MFG Unlock project and its contributors. RenoDX MFG Unlocker is an independent utility for selecting and installing published addon releases." Foreground="#A9A6B4" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/><TextBlock Text="Choose your game. Select a release. Install with confidence." Foreground="#D0C1F3" FontSize="11" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid></Grid></Border>
</Window>