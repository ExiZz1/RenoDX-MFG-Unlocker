<UserControl x:Class="RenoDXMfgUnlocker.SetupWizardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0C0D12" Foreground="#F4F2FA">
 <UserControl.Resources>
  <Style x:Key="RailButton" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="RailSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RailSurface" Property="Background" Value="#242031"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RailSurface" Property="BorderThickness" Value="1"/><Setter TargetName="RailSurface" Property="BorderBrush" Value="#A582E9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="WizardCardButton" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#F4F2FA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CardSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#B08DE8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#DBC7FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="CardSurface" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource PremiumScrollBar}"/>
  <Style x:Key="WizardFilesList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="Background" Value="#111218"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ScrollViewer" Padding="0" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#101117" BorderBrush="#26242F" BorderThickness="0,0,0,1" MouseLeftButtonDown="HeaderDrag"><Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/RenoDX.png" Width="32" Height="32"/><TextBlock Text="RENODX" FontSize="15" FontWeight="Bold" Margin="12,0,8,0" VerticalAlignment="Center"/><TextBlock Text="/ MFG UNLOCKER" Foreground="#9893A8" FontSize="11" VerticalAlignment="Center"/><Border Background="#211B30" BorderBrush="#393047" BorderThickness="1" CornerRadius="8" Margin="14,0,0,0" Padding="10,6"><TextBlock x:Name="VersionText" FontSize="10" Foreground="#C8B8EC"/></Border></StackPanel><Button x:Name="SettingsButton" Grid.Column="2" ToolTip="Application settings" Padding="12,6" VerticalAlignment="Center"><Path Data="{StaticResource SettingsGearGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" StrokeLineJoin="Round"/></Button></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#0F1016" BorderBrush="#26242F" BorderThickness="0,0,1,0"><DockPanel Margin="12,26,12,18"><TextBlock DockPanel.Dock="Top" Text="SETUP WIZARD" FontSize="10" FontWeight="Bold" Foreground="#B397F0" Margin="12,0,0,18"/><TextBlock DockPanel.Dock="Bottom" Text="Manual / Advanced" Foreground="#797386" FontSize="10" Margin="12,16,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="NavigationPanel"/></ScrollViewer></DockPanel></Border>
   <Grid Grid.Column="1" Margin="24,22,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="Setup Wizard" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Select Game" Foreground="#BAA6E4" FontSize="15" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SubtitleText" Foreground="#9E98AB" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition x:Name="DetailsColumn" Width="310"/></Grid.ColumnDefinitions>
     <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0"><StackPanel x:Name="ContentPanel"/></ScrollViewer>
     <Border x:Name="SidebarBorder" Grid.Column="2" Background="#13141C" BorderBrush="#2C2938" BorderThickness="1" CornerRadius="16" Padding="16" VerticalAlignment="Top"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SidebarPanel"/></ScrollViewer></Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel x:Name="ReviewActionsPanel" Margin="0,0,0,6"/><StackPanel Grid.Row="1" x:Name="ApprovalPanel" Margin="0,0,0,4"/><ProgressBar Grid.Row="2" x:Name="OperationProgress" Height="4" Foreground="#9C73F0" Background="#292234" Visibility="Collapsed"/><TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#CCB8F4" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,6"/><Grid Grid.Row="4" x:Name="FooterPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions></Grid></Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
