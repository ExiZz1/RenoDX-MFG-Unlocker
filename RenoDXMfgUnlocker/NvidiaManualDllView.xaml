<UserControl x:Class="RenoDXMfgUnlocker.NvidiaManualDllView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource Text}">
 <UserControl.Resources>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#191B23"/><Setter Property="Foreground" Value="#E7E1F2"/><Setter Property="Padding" Value="9,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#302743"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#493B68"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource PremiumScrollBar}"/>
 </UserControl.Resources>
 <Grid Margin="24,18,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="NVIDIA SDK — Manual DLL Management" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel x:Name="ModePanel" Margin="0,10,0,10"/><TextBlock x:Name="WorkflowText" Foreground="{StaticResource Purple}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="DisclaimerText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,10,0"><TextBlock Text="Target Game" Foreground="{StaticResource Purple}" FontSize="11"/><ComboBox x:Name="GamePicker" DisplayMemberPath="Name" Height="36" Margin="0,5,0,5"/><TextBlock x:Name="ExeText" TextWrapping="Wrap" FontSize="11"/><Button x:Name="BrowseExeButton" Content="Browse game EXE" HorizontalAlignment="Left" Padding="12,7" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Confirmed destination" Foreground="{StaticResource Purple}" FontSize="11"/><TextBlock x:Name="TargetText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,5"/><Button x:Name="TargetButton" Content="Confirm target folder" HorizontalAlignment="Left" Padding="12,7" Margin="0,4,0,0"/><TextBlock Text="Only the explicitly confirmed EXE directory is writable. Other scanned folders remain read-only." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Official Streamline SDK" Foreground="{StaticResource Purple}" FontWeight="SemiBold"/><ComboBox x:Name="SdkPicker" DisplayMemberPath="Label" Height="38" Margin="0,8,0,7"/><WrapPanel><Button x:Name="RefreshButton" Content="Refresh official SDKs" Padding="10,7" Margin="0,0,7,5"/><Button x:Name="PrepareButton" Content="Download / Prepare" Padding="10,7" Margin="0,0,7,5"/><Button x:Name="ImportButton" Content="Import matching local SDK ZIP" Padding="10,7" Margin="0,0,0,5"/></WrapPanel><TextBlock x:Name="PackageText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,7"><Button x:Name="CommonButton" Content="Common Runtime Components" Padding="10,7" Margin="0,0,7,5"/><Button x:Name="AllButton" Content="All SDK Components" Padding="10,7" Margin="0,0,7,5"/><Button x:Name="SelectionButton" Content="Component selection" Padding="10,7" Margin="0,0,7,5"/><Button x:Name="PreviewButton" Content="Verify Selected DLLs" Padding="10,7" Margin="0,0,0,5"/></WrapPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PremiumScrollBar}"/></ScrollViewer.Resources><StackPanel x:Name="FileRows"/></ScrollViewer>
   </Grid></Border>
   <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PremiumScrollBar}"/></ScrollViewer.Resources><StackPanel><TextBlock Text="Preview summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="SummaryText" TextWrapping="Wrap"/><TextBlock x:Name="WarningsText" TextWrapping="Wrap" FontSize="12" Foreground="#C6B9D7" Margin="0,12,0,10"/><TextBlock Text="Restore is available for transactions recorded by this application; external changes can block recovery." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="ApplyReasonText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><CheckBox x:Name="Consent" Margin="0,0,0,9"/><ProgressBar x:Name="Progress" Height="4" Visibility="Collapsed" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#C9B9FF" VerticalAlignment="Center" Margin="0,0,10,0"/><WrapPanel Grid.Column="1"><Button x:Name="RestoreButton" Content="Restore / review transactions" Padding="12,9" Margin="0,0,7,0"/><Button x:Name="CancelButton" Content="Close" Padding="12,9" Margin="0,0,7,0"/><Button x:Name="ApplyButton" Content="Apply Verified Changes" Padding="14,9" Background="#704BD0" BorderBrush="#8E6FF0" IsEnabled="False"/></WrapPanel></Grid></StackPanel>
 </Grid>
</UserControl>
