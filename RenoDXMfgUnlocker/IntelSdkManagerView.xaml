<UserControl x:Class="RenoDXMfgUnlocker.IntelSdkManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RenoDXMfgUnlocker" Foreground="{StaticResource Text}">
 <UserControl.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PremiumScrollBar}"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#1C1825" BorderBrush="#453356" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="CompatibleText" Text="MFG Unlock Compatible" Foreground="#CFB5F6" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Official Latest is not a compatibility recommendation. SDK numbers and DLL versions are separate. Only the pinned runtime catalog may be used by Setup Wizard." FontSize="12" Foreground="#B3A9C3" TextWrapping="Wrap" Margin="0,6,0,0"/><WrapPanel Margin="0,8,0,0"><Button x:Name="PrepareCompatibleButton" Content="Prepare compatible runtime" Padding="12,7" Margin="0,0,8,4"/><Button x:Name="WizardButton" Content="DLL Installation" Padding="12,7" Margin="0,0,8,4"/><Button x:Name="OfficialButton" Content="Official Intel releases" Padding="12,7" Margin="0,0,0,4"/></WrapPanel></StackPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#14151D" BorderBrush="#2B2937" BorderThickness="1" CornerRadius="13" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Official Intel XeSS SDKs" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh list" Padding="10,6"/></Grid>
    <ListBox x:Name="ReleasesList" Grid.Row="1" Background="#14151D" Foreground="#F1EBF8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock local:LocalizedPresentation.PreserveOriginal="True" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#AFA4BF" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Classification}" FontSize="11" Foreground="#C1A2ED" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="DownloadButton" Content="Download / Prepare" Padding="13,8" Margin="0,0,8,4" IsEnabled="False" Background="#65439F"/><Button x:Name="ImportArchiveButton" Content="Use existing SDK ZIP" Padding="12,8" Margin="0,0,8,4" IsEnabled="False"/><Button x:Name="ReleaseDetailsButton" Content="Details" Padding="12,8" Margin="0,0,0,4" IsEnabled="False"/></WrapPanel>
   </Grid></Border>
   <Border Grid.Column="2" Background="#14151D" BorderBrush="#2B2937" BorderThickness="1" CornerRadius="13" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10"><TextBlock x:Name="LocalTitle" Text="Selected SDK Components" FontSize="15" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,8"><Button x:Name="SelectedSdkModeButton" Content="Selected SDK Components" Padding="9,6" Margin="0,0,6,4" Background="#332542"/><Button x:Name="CompatibleModeButton" Content="MFG Unlock Compatible" Padding="9,6" Margin="0,0,0,4"/></WrapPanel><TextBlock x:Name="PanelContextText" FontSize="11" Foreground="#C6B2E2" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock x:Name="LocalStatus" Text="Select a release to inspect prepared files." Foreground="#AFA4BF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LocalFiles"/></ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button x:Name="CatalogEvidenceButton" Content="Catalog evidence" Padding="10,6" Margin="0,0,8,4" Visibility="Collapsed"/><Button x:Name="OpenDownloadsButton" Content="Open downloads" Padding="10,6" Margin="0,0,8,4"/><Button x:Name="OpenStagingButton" Content="Open staging" Padding="10,6" Margin="0,0,0,4" IsEnabled="False"/></WrapPanel>
   </Grid></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Refresh the official Intel release list." FontSize="12" Foreground="#C9B6E7" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,0" Visibility="Collapsed" Minimum="0" Maximum="100"/></StackPanel><Button Grid.Column="1" x:Name="StatusDetailsButton" Content="Details" Padding="12,7" Margin="12,0,0,0" Visibility="Collapsed"/><Button Grid.Column="2" x:Name="CancelButton" Content="Cancel" Padding="12,7" Margin="12,0,0,0" IsEnabled="False"/></Grid>
 </Grid>
</UserControl>
